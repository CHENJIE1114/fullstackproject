{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,

    "types": ["node"],
    "rootDir": "."
  },

  "include": [
    "*.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}